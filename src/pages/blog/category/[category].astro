---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PostRow from '../../../components/PostRow.astro';
import BlogCategoryFilter from '../../../components/BlogCategoryFilter.astro';
import { encodeSlugId } from '../../../lib/slug';
import { getAllCategories, getPublishedPosts } from '../../../lib/content';
import { SITE_TITLE, categoryLabel } from '../../../consts';

export async function getStaticPaths() {
  const categories = await getAllCategories();
  const posts = await getPublishedPosts();
  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      categories,
      posts: posts.filter((p) => p.data.category === category),
    },
  }));
}

const { category, categories, posts } = Astro.props;
const label = categoryLabel(category) ?? category;

const canonicalUrl = new URL(
  `/blog/category/${encodeSlugId(category)}/`,
  Astro.site
).toString();
---

<SiteLayout
  title={`${label} | Blog | ${SITE_TITLE}`}
  description={`「${label}」カテゴリの記事一覧 (${posts.length} 件)`}
  canonicalUrl={canonicalUrl}
  mainClass="category-index"
>
  <SectionHead jp={label} en="category archive" />

  <BlogCategoryFilter categories={categories} activeCategory={category} />

  <p class="category-count kw-mono no-indent">{posts.length} 件</p>

  <div class="posts-list">
    {posts.map((post, i) => (
      <PostRow
        num={String(i + 1).padStart(2, '0')}
        href={`/blog/${encodeSlugId(post.id)}/`}
        titleTag="h2"
        title={post.data.title}
        description={post.data.description?.trim()}
        pubDate={post.data.pubDate}
        category={categoryLabel(post.data.category)}
        id={post.id}
      />
    ))}
  </div>

  {posts.length === 0 && (
    <p class="empty-message no-indent">
      このカテゴリの記事はまだありません。<a href="/blog/">記事一覧</a>へ戻るか、全文検索をお試しください。
    </p>
  )}
</SiteLayout>

<style>
  .category-index {
    width: min(var(--kw-content-max), 100%);
  }

  .category-count {
    font-size: var(--kw-fs-mono-xs);
    color: var(--kw-fg-muted);
    margin-bottom: var(--kw-space-6);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .empty-message {
    font-size: var(--kw-fs-body-sm);
    color: var(--kw-fg-muted);
    padding: var(--kw-space-10) 0;
    text-align: center;
  }
</style>
