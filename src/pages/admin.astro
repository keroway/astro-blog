---
// Sveltia CMS — @sveltia/cms npm パッケージからバンドルされる静的 SPA (ADR 0016)。
// Astro バージョンに依存しないため、Astro メジャーアップ時もここを変更不要。
// 設定: public/admin/config.yml
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- robots: admin は検索インデックス不要 (vercel.json の X-Robots-Tag と二重防衛) -->
    <meta name="robots" content="noindex, nofollow" />
    <title>keroway CMS</title>
    <!-- Web fonts — self-hosted via Astro Fonts API + Fontsource (ADR 0013)。
         Sveltia CMS 本体への反映は theme.css 側の --sui-font-family-* 上書きで行う。 -->
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      (() => {
        let theme = "light";

        // Sveltia CMS 自身の prefs (localStorage["sveltia-cms.prefs"]) が
        // dataset.theme を上書きするより先に、サイト本体の設定を初期値として
        // 反映しておく (CMS.init() 前の FOUC 防止用の先読みヒント)。
        try {
          const stored = localStorage.getItem("theme");
          theme = stored === "dark" || stored === "light"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
        } catch {}

        // Sveltia CMS は「import CMS from "@sveltia/cms"」の評価時点で自身の
        // prefs (localStorage["sveltia-cms.prefs"]) をメモリに読み込むため、
        // それより後 (下の module script 内) で書き込んでも間に合わない。
        // ここで import 前に書き込み、ja ロケールとテーマを固定する
        // (issue #622)。対応するキー・スキーマがなければ黙って握りつぶし、
        // navigator.language / Sveltia 既定のフォールバックに委ねる。
        try {
          const PREFS_KEY = "sveltia-cms.prefs";
          const prefs = JSON.parse(localStorage.getItem(PREFS_KEY) ?? "{}");

          prefs.locale ??= "ja";
          prefs.theme = theme;
          localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
        } catch {}
      })();
    </script>
    <link rel="stylesheet" href="/admin/theme.css" />
    <script>
      import CMS from "@sveltia/cms";
      import { parse, stringify } from "yaml";

      const normalizeDates = (value: any): any => {
        if (value instanceof Date) {
          return value.toISOString().slice(0, 10);
        }

        if (Array.isArray(value)) {
          return value.map(normalizeDates);
        }

        if (value && typeof value === "object") {
          return Object.fromEntries(
            Object.entries(value).map(([key, childValue]) => [
              key,
              normalizeDates(childValue),
            ]),
          );
        }

        return value;
      };

      const splitFrontmatter = (text: string) => {
        const normalized = text.replace(/^\uFEFF/, "");

        if (!normalized.startsWith("---\n")) {
          return { frontmatter: {}, body: normalized };
        }

        const end = normalized.indexOf("\n---", 4);

        if (end === -1) {
          return { frontmatter: {}, body: normalized };
        }

        const frontmatterText = normalized.slice(4, end);
        const bodyStart = normalized.startsWith("\n", end + 4) ? end + 5 : end + 4;

        return {
          frontmatter: normalizeDates(parse(frontmatterText) ?? {}),
          body: normalized.slice(bodyStart),
        };
      };

      CMS.registerCustomFormat("mdoc", "mdoc", {
        fromFile: (text) => {
          const { frontmatter, body } = splitFrontmatter(text);

          return { ...frontmatter, body };
        },
        toFile: (data) => {
          const { body = "", ...frontmatter } = normalizeDates(data ?? {});
          const yaml = stringify(frontmatter, {
            lineWidth: 100,
            sortMapEntries: false,
          }).trim();

          return `---\n${yaml}\n---\n\n${body}`;
        },
      });

      const response = await fetch("/admin/config.yml");
      const config = parse(await response.text());

      CMS.registerPreviewStyle("/admin/preview.css");

      // Astro Fonts API (astro:assets の <Font />) は @font-face と --font-*
      // 変数をこのページの <style> タグとして出力する。プレビューは別ドキュメント
      // の iframe (sandbox="allow-same-origin") として描画されるため、親の
      // <link>/<style> は継承されない。@font-face を含むブロックだけを抜き出し、
      // raw CSS として同じフォントをプレビュー内にも注入する。
      const fontFaceCss = [...document.querySelectorAll("style")]
        .map((style) => style.textContent ?? "")
        .filter((css) => css.includes("@font-face"))
        .join("\n");

      if (fontFaceCss) {
        CMS.registerPreviewStyle(fontFaceCss, { raw: true });
      }

      config.load_config_file = false;
      config.app_title = "keroway CMS";
      config.site_url = "https://keroway.com";
      config.display_url = "keroway.com";
      config.show_preview_links = true;
      config.collections = config.collections.map((collection: any) =>
        ["blog", "works"].includes(collection.name)
          ? { ...collection, format: "mdoc" }
          : collection,
      );

      // dev サーバー限定・明示クエリ付きのときだけ OPFS ベースの test-repo backend に
      // 差し替える。ログイン不要でコレクション一覧・編集画面・プレビューを確認できる
      // (UI 改善の検証用、issue #621)。本番バンドルでは import.meta.env.DEV が false に
      // 評価されるため、この分岐ごと dead code として扱われる。
      if (import.meta.env.DEV && new URLSearchParams(location.search).has("test-repo")) {
        config.backend = { name: "test-repo" };
      }

      // ja ロケールとテーマの localStorage["sveltia-cms.prefs"] 書き込みは、
      // このファイル先頭の <script is:inline> (import CMS より前) で行う。
      // import 文の評価時に Sveltia が prefs を読み込むため、ここではもう遅い。

      const actionRules = [
        {
          type: "primary",
          pattern:
            /(ローカル|テスト)(リポジトリ|レポジトリ)|Work with (Local|Test) Repository|保存|Save|作成|New|Create|投稿|Submit/iu,
        },
        {
          type: "danger",
          pattern: /削除|Delete|破棄|Discard|Remove|リセット|Reset/iu,
        },
        {
          type: "secondary",
          pattern:
            /GitHub|プレビュー|Preview|公開|Publish|アップロード|Upload|メディア|Media/iu,
        },
        {
          type: "subtle",
          pattern:
            /Access Token|アクセストークン|キャンセル|Cancel|閉じる|Close|戻る|Back|編集|Edit/iu,
        },
      ];

      // Sveltia CMS 同梱の ja ロケール (上記 prefs.locale) が UI 全体の翻訳を
      // 担うため、ログイン画面の文言を個別に書き換える処理は持たない。
      // ここでは「ログイン画面かどうか」の判定だけ ja/en 両方の文言に対応させる。
      // ログイン後のアカウントメニューに「(ローカル|テスト)レポジトリで作業中」
      // という現在の接続状態を示す表示が出るため、末尾に続く文字がないことまで
      // 要求してログイン画面判定との衝突を避ける (issue #622)。
      const isLoginScreen = () =>
        [...document.querySelectorAll("button, a")].some((element) =>
          /^Work with (Local|Test) Repository$|^(ローカル|テスト)(リポジトリ|レポジトリ)で(編集|作業)$|Sign In|ログイン/iu.test(
            element.textContent?.replace(/\s+/g, " ").trim() ?? "",
          ),
        );

      const renderLoginGuide = () => {
        const note = document.querySelector(".keroway-admin-shell-note");

        if (!isLoginScreen()) {
          note?.remove();
          return;
        }

        if (note) return;

        const nextNote = document.createElement("aside");
        nextNote.className = "keroway-admin-shell-note";
        nextNote.setAttribute("aria-label", "CMS の使い方");
        nextNote.innerHTML = `<strong>推奨: ローカルレポジトリで作業</strong><span>通常は「ローカルレポジトリで作業」を選び、astro-blog のルートを指定します。GitHub ログインは本番環境用です。</span>`;
        document.body.append(nextNote);
      };

      // プレビューは別ドキュメントの iframe (sandbox="allow-same-origin") として
      // 描画され、Sveltia CMS は data-theme をここへ伝播しない。preview.css は
      // 親と同じ [data-theme] セレクタでライト/ダークを切り替えるため、
      // 親の <html data-theme> をそのままミラーする。
      const syncPreviewTheme = () => {
        const doc = document.querySelector<HTMLIFrameElement>(
          "iframe.preview",
        )?.contentDocument;
        const theme = document.documentElement.dataset.theme;

        if (doc?.documentElement && theme) {
          doc.documentElement.dataset.theme = theme;
        }
      };

      // iframe の中身がロードされる完了タイミングは、親 document の body
      // MutationObserver では検知できない (iframe 要素自体は既に body 配下に
      // あり、その "中身" の構築は別ドキュメントの読み込みのため)。
      // load イベントで確実にテーマを同期する。同じ iframe 要素には
      // 一度だけリスナーを付ける。
      const observedPreviewIframes = new WeakSet<HTMLIFrameElement>();

      const watchPreviewIframe = () => {
        const iframe = document.querySelector<HTMLIFrameElement>(
          "iframe.preview",
        );

        if (iframe && !observedPreviewIframes.has(iframe)) {
          observedPreviewIframes.add(iframe);
          iframe.addEventListener("load", syncPreviewTheme);
        }
      };

      const classifyAdminActions = () => {
        renderLoginGuide();
        syncPreviewTheme();
        watchPreviewIframe();

        document
          .querySelectorAll<HTMLButtonElement | HTMLAnchorElement>(
            'button, [role="button"], a',
          )
          .forEach((element) => {
            const text =
              element.textContent?.replace(/\s+/g, " ").trim() ||
              element.getAttribute("aria-label") ||
              element.getAttribute("title") ||
              "";
            const matched = actionRules.find(({ pattern }) => pattern.test(text));

            if (matched) {
              element.dataset.kerowayAdminAction = matched.type;
            }
          });
      };

      CMS.init({ config });

      const observer = new MutationObserver(classifyAdminActions);
      observer.observe(document.body, { childList: true, subtree: true });

      // Sveltia CMS の設定パネルでテーマを切り替えると <html data-theme> が
      // 変わる。body の childList とは別に監視し、プレビュー iframe への
      // ミラーを追従させる。
      const themeObserver = new MutationObserver(syncPreviewTheme);
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      classifyAdminActions();
    </script>
  </head>
  <body>
    <!-- 設定は public/admin/config.yml で管理。 -->
  </body>
</html>
