---
import foucGuardUrl from "../scripts/fouc-guard.js?url";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getAllFocusAreas } from "../data/focus-areas";
import { serializeJsonLd } from "../lib/json-ld";
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	image?: string | null;
	/** og:image の実寸。省略時は既定の 1200x630 (OGP 生成画像) */
	/** null で og:image:width を省略する (実寸不明の外部画像用)。undefined は 1200。 */
	imageWidth?: number | null;
	/** null で og:image:height を省略する。undefined は 630。 */
	imageHeight?: number | null;
	locale?: string;
	canonicalUrl?: string;
	articleSchema?: Record<string, unknown>;
	breadcrumbSchema?: Record<string, unknown>;
}

const { title, description, image = "/og-default.png", imageWidth = 1200, imageHeight = 630, locale = "ja_JP", canonicalUrl, articleSchema, breadcrumbSchema } = Astro.props;
const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = image ? new URL(image, Astro.url).toString() : null;
const ogImageAlt = title || SITE_TITLE;

const siteUrl = Astro.site ? new URL("/", Astro.site).toString() : `${Astro.url.origin}/`;
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"@id": `${siteUrl}#person`,
	name: SITE_AUTHOR,
	url: siteUrl,
	jobTitle: "Software Engineer",
	description: "組み込みからクラウド、フロントエンドまで横断するソフトウェアエンジニア。",
	// focus-areas.ts の title から生成し、専門分野が増えても自動追随する (#554)
	knowsAbout: getAllFocusAreas().map((area) => area.title),
	sameAs: ["https://twitter.com/keroway21", "https://github.com/keroway"],
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteUrl,
	inLanguage: locale.replace("_", "-"),
	author: { "@id": `${siteUrl}#person` },
};
---

<!-- Theme & reduced-motion: FOUC prevention — must run before first paint.
     外部ファイルの同期 classic script (CSP の script-src 'self' のため。ADR 0021) -->
<script is:inline src={foucGuardUrl}></script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<!-- theme-color: ライト/ダークでブラウザ chrome をデザイントークンに合わせる -->
<meta name="theme-color" content="#F3F1EC" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0B1B33" media="(prefers-color-scheme: dark)" />
<meta name="generator" content={Astro.generator} />

<!-- Web fonts — self-hosted via Astro Fonts API + Fontsource (ADR 0013) -->
<Font cssVariable="--font-display" />
<Font cssVariable="--font-body" />
<Font cssVariable="--font-mono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- RSS feed auto-discovery -->
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} Feed`} href={new URL("/feed.xml", Astro.site)} />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} Blog`} href={new URL("/rss.xml", Astro.site)} />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} Works`} href={new URL("/works/rss.xml", Astro.site)} />
<ClientRouter fallback="animate" />
<!-- Speculation Rules: Chrome など対応ブラウザで同一サイト内遷移を prerender する (#474)。非対応ブラウザでは無視される。 -->
<script is:inline type="speculationrules">
  {
    "prerender": [
      {
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/admin*" } },
            { "not": { "href_matches": "/api*" } }
          ]
        },
        "eagerness": "moderate"
      }
    ]
  }
</script>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale} />
{ogImageUrl && (
	<>
		<meta property="og:image" content={ogImageUrl} />
		{imageWidth != null && imageHeight != null && (
			<>
				<meta property="og:image:width" content={String(imageWidth)} />
				<meta property="og:image:height" content={String(imageHeight)} />
			</>
		)}
		<meta property="og:image:alt" content={ogImageAlt} />
	</>
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{ogImageUrl && (
	<>
		<meta property="twitter:image" content={ogImageUrl} />
		<meta property="twitter:image:alt" content={ogImageAlt} />
	</>
)}

<!-- Structured data (JSON-LD) -->
<script is:inline type="application/ld+json" set:html={serializeJsonLd(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={serializeJsonLd(personSchema)} />
{articleSchema && (
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(articleSchema)} />
)}
{breadcrumbSchema && (
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />
)}

<!-- Vercel Web Analytics — cookie-less, injected via Vercel's edge path -->
<script is:inline defer src="/_vercel/insights/script.js"></script>
