{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "残りのマイナー / パッチはまとめて 1 PR にしてノイズを抑える。major は個別 PR で内容を確認して取り込む。astrojs / dev-tooling グループは後続ルールで上書きされる",
      "groupName": "npm-minor-patch",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Astro 本体と @astrojs/* は lockstep 依存のため 1 PR にまとめる",
      "groupName": "astrojs",
      "matchPackageNames": ["astro", "@astrojs/*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "dev-tooling",
      "matchPackageNames": ["@playwright/*", "typescript"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "major はビルド互換性への影響が大きいため自動更新しない (手動で上げる)",
      "matchPackageNames": ["typescript", "astro"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "pnpm-workspace.yaml の overrides (depType: pnpm-workspace.overrides) は、脆弱性の下限を守る上限付きレンジを手で管理している。範囲指定の値は更新種別の判定ができず、major への引き上げ提案が依存元のレンジ (例: postcss の nanoid 3 系) と衝突して壊すため、Renovate には更新させない。必要なら osv-scan の指摘を起点に手で上げる",
      "matchDepTypes": ["pnpm-workspace.overrides", "pnpm.overrides"],
      "enabled": false
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
