# build output
dist/
# Vercel adapter (@astrojs/vercel) build artifact
.vercel/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*



# macOS-specific files
.DS_Store
# Windows NTFS Alternate Data Streams (accidentally committed via cross-platform tools)
*:Zone.Identifier

# local tooling / test artifacts。
# settings.json / agents / commands / rules / hooks はチーム共有する Claude Code 設定としてトラッキング。
# settings.local.json / worktrees / file-history などのセッションローカルなものは ignore のまま。
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/rules/
!.claude/hooks/
!.claude/claude-security-guidance.md
!.claude/README.md
# Codex CLI の Stop hook 設定。hooks.json が絶対パスを含む個人ローカル層で、
# 共有すると他の環境で壊れる (keroway/agent-assets#186)
.codex/
.serena/
test-results/
.playwright-mcp/
.pnpm-store/
# Lighthouse CI artifacts
lhci-reports/
.lighthouseci/
# lychee link checker on-disk cache (regenerated each run)
.lycheecache
# pi coding agent (remote-pi) のセッションデータ
.pi/

# pi-subagents artifacts
.pi-subagents/

# Environment / secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.secret
*.pem
*.key

# Codex CLI / agent-assets symlink (~/.agents) / pi のローカル生成物・個人状態。
# いずれも絶対パスや個人環境固有の値を含みうる個人ローカル層で、
# 共有すると他の環境で壊れる (keroway/agent-assets#186)
.agents/

# npm registry の切替はローカルの環境変数か個人用 .npmrc で行う (#695、リポジトリには同梱しない)
.npmrc
